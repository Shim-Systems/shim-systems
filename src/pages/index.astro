---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import DictionaryCallout from "@/components/sections/DictionaryCallout.astro";
import Solutions from "@/components/sections/Solutions.astro";
import Process from "@/components/sections/Process.astro";
import Faq from "@/components/sections/Faq.astro";
import Cta from "@/components/sections/Cta.astro";
import { siteConfig } from "@/config/site";
---

<Layout
	title={siteConfig.meta.title}
	description={siteConfig.meta.description}
	keywords={siteConfig.meta.keywords}
>
	<Hero />

	<DictionaryCallout />

	<div class="site-container my-4 border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

	<Solutions />

	<div class="site-container my-4 border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

	<Process />

	<div class="site-container my-4 border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

	<Faq />

	<Cta />
</Layout>