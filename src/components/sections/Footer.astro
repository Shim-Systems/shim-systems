---
import Logo from "@/components/ui/Logo.astro";
import ToTop from "@/components/widgets/ToTop.astro";
---

<section class="mt-20 border-t border-dashed border-primary/15 text-gray-700 dark:border-primary-dark/15 md:mt-32">
	<div class="container mx-auto max-w-7xl px-7 py-12 md:py-16">
		<div class="mb-10 flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
			<div class="max-w-sm">
				<Logo />
				<p class="mt-4 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
					Practical systems architecture for growing organisations—replacing the mess with streamlined tools.
				</p>
			</div>

			<div class="grid grid-cols-2 gap-8 md:gap-12">
				<div>
					<h4 class="mb-4 text-sm font-semibold text-neutral-800 dark:text-neutral-200">Practice</h4>
					<ul class="space-y-3">
						<li><a href="#solutions" class="text-sm text-neutral-500 transition-colors duration-200 hover:text-primary dark:text-neutral-400 dark:hover:text-primary-light">Solutions</a></li>
						<li><a href="#process" class="text-sm text-neutral-500 transition-colors duration-200 hover:text-primary dark:text-neutral-400 dark:hover:text-primary-light">Process</a></li>
						<li><a href="#faq" class="text-sm text-neutral-500 transition-colors duration-200 hover:text-primary dark:text-neutral-400 dark:hover:text-primary-light">FAQ</a></li>
						<li><a href="#contact" class="text-sm text-neutral-500 transition-colors duration-200 hover:text-primary dark:text-neutral-400 dark:hover:text-primary-light">Contact</a></li>
					</ul>
				</div>
				<div>
					<h4 class="mb-4 text-sm font-semibold text-neutral-800 dark:text-neutral-200">Connect</h4>
					<ul class="space-y-3">
						<li><a href="mailto:office@shimsystems.com" class="text-sm text-neutral-500 transition-colors duration-200 hover:text-primary dark:text-neutral-400 dark:hover:text-primary-light">Get in touch</a></li>
					</ul>
				</div>
			</div>
		</div>

		<div class="flex flex-col items-center justify-between gap-4 border-t border-dashed border-primary/10 pt-8 dark:border-primary-dark/10 sm:flex-row">
			<p class="text-sm text-neutral-400 dark:text-neutral-500">© {new Date().getFullYear()} SHIM Systems. All rights reserved.</p>
			<div class="flex items-center gap-4">
				<span class="text-xs text-neutral-400 dark:text-neutral-500">
					Melbourne, Victoria
				</span>
			</div>
		</div>
	</div>
</section>

<ToTop />