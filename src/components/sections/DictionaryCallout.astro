---
import content from "@/config/siteContent.json";
import { BookOpen } from "@lucide/astro";
---

<section class="site-container py-12">
	<div class="rounded-xl border border-primary/20 bg-bg-secondary p-6 md:p-8 dark:border-neutral-700 dark:bg-bg-secondary-dark max-w-3xl relative overflow-hidden transition-all duration-300 hover:shadow-[0_12px_30px_rgba(var(--color-primary-rgb),0.06)]">
		
		<!-- Header / Meta -->
		<div class="flex items-center justify-between mb-4">
			<div class="flex items-center gap-2 text-primary font-mono text-xs uppercase tracking-wider">
				<BookOpen class="h-4 w-4" />
				<span>Lexicon // Core Concept</span>
			</div>
			<span class="font-mono text-xs italic text-neutral-400 dark:text-neutral-500">{content.dictionary.partOfSpeech}</span>
		</div>

		<!-- Term & Definition -->
		<div class="space-y-2">
			<h3 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
				{content.dictionary.term}
			</h3>
			<p class="text-neutral-600 dark:text-neutral-300 text-base md:text-lg leading-relaxed">
				{content.dictionary.definition}
			</p>
		</div>

	</div>
</section>