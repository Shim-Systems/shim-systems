---
import content from "@/config/siteContent.json";
---

<section class="site-container py-12">
	<div class="rounded-xl border border-primary/20 bg-bg-secondary p-6 md:p-8 dark:border-neutral-700 dark:bg-bg-secondary-dark max-w-3xl">
		<div class="flex items-baseline gap-3 mb-2">
			<h3 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">{content.dictionary.term}</h3>
			<span class="font-mono text-xs italic text-primary">{content.dictionary.partOfSpeech}</span>
		</div>
		<p class="text-neutral-600 dark:text-neutral-300 text-sm md:text-base leading-relaxed">
			{content.dictionary.definition}
		</p>
	</div>
</section>