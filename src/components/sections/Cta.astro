---
import Button from "@/components/ui/Button.astro";
import content from "@/config/siteContent.json";
import { ArrowRight } from "@lucide/astro";
---

<section class="site-container py-12 md:py-20" id="contact">
	<div
		class="rounded-xl border border-primary/10 bg-bg-secondary p-7 text-center dark:border-neutral-700 dark:bg-bg-secondary-dark md:p-10"
	>
		<h2 class="mx-auto mb-4 max-w-2xl text-3xl md:text-4xl">{content.cta.headline}</h2>
		<p class="mx-auto mb-2 max-w-2xl text-neutral-600 dark:text-neutral-300 italic text-sm">
			{content.cta.warning}
		</p>
		<div class="mt-6 flex flex-wrap justify-center gap-3">
			<Button url="mailto:office@shimsystems.com" type="fill">
				{content.cta.buttonText} <ArrowRight size={16} />
			</Button>
		</div>
	</div>
</section>