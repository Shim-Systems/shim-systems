---
import content from "@/config/siteContent.json";
import AccordionItem from "@/components/ui/AccordionItem.astro";
---

<section class="site-container py-16 md:py-24" id="faq">
	<div class="mb-12">
		<span class="text-xs font-mono uppercase tracking-widest text-[var(--color-text-meta,theme(colors.neutral.500))]">
			Common Questions
		</span>
		<h2 class="mt-2 text-3xl md:text-4xl">Everything you need to know.</h2>
	</div>

	<div class="max-w-3xl space-y-2">
		{content.faq.map((item, index) => (
			<AccordionItem 
				question={item.question} 
				answer={item.answer} 
				index={index}
			/>
		))}
	</div>
</section>