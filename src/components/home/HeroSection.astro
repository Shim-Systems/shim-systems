---
// src/components/home/HeroSection.astro
import Button from '../ui/Button.astro';
---

<section class="site-container py-16 md:py-24">
  <div class="space-y-6 max-w-3xl">
    <div class="space-y-2">
      <span class="text-xs font-mono uppercase tracking-widest text-[var(--color-text-meta,theme(colors.neutral.500))]">
        SHIM // Systems Practice
      </span>
      <h1 class="text-4xl md:text-6xl font-brand tracking-tight leading-tight">
        <span class="block">Reclaim your time.</span>
        <span class="block text-primary">Amplify your impact.</span>
      </h1>
    </div>
    
    <p class="text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-2xl">
      Mission-driven teams shouldn't lose hours to operational friction. We provide practical systems architecture for environmental and social-impact enterprises—replacing the mess with streamlined tools that let you focus on the work that matters.
    </p>

    <div class="flex items-center gap-4 pt-4">
      <Button url="#services" type="fill">Explore Services</Button>
      <Button url="#faq">Common Questions</Button>
    </div>
  </div>
</section>